# Copy to .env and adjust. Every gwent.* property of backend/src/main/resources/application.yml can be
# overridden here as an environment variable (gwent.game.turn-timeout -> GWENT_GAME_TURN_TIMEOUT).

# public port of the web container
GWENT_WEB_PORT=47320
# origins allowed to open the WebSocket / call the API (your public URL in production)
GWENT_ALLOWED_ORIGINS=http://localhost:47320,http://127.0.0.1:47320

# time per move and for the reconnect of a dropped player
GWENT_GAME_TURN_TIMEOUT=60s
GWENT_GAME_RECONNECT_GRACE=45s
# time to accept a found match
GWENT_MATCHMAKING_CONFIRM_TIMEOUT=20s
# limits
GWENT_SESSION_MAX_SESSIONS=5000
GWENT_GAME_MAX_CONCURRENT_GAMES=1000

# --- planned, not implemented yet: accounts with Google sign-in (off by default) ---
# GWENT_AUTH_GOOGLE_ENABLED=false
# GWENT_AUTH_GOOGLE_CLIENT_ID=
# GWENT_AUTH_GOOGLE_CLIENT_SECRET=
